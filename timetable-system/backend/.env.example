# Full UTB2 publication endpoint. Use HTTPS on the server.
STUDENT_PUBLISH_URL=http://127.0.0.1:8001/api/v1/publication
# Same random secret (at least 32 characters) in both backends; never in VITE_*.
PUBLISH_SECRET_KEY=
# Production defaults to true. run_dev.py sets false for local HTTP only.
AUTH_COOKIE_SECURE=true
